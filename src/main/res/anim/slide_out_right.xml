<?xml version="1.0" encoding="utf-8"?>
<!--
    Home leaves to the right when the app comes in from the left (LaunchAnimation.FromLeft): it moves
    30% of the width, the parallax of NavTravel.horizontalParallax, and dims to 68% (VoidAlpha.coveredByPanel).
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:fromXDelta="0"
        android:toXDelta="30%p"
        android:duration="300"
        android:interpolator="@interpolator/emphasized_decelerate" />
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.68"
        android:duration="300"
        android:interpolator="@interpolator/emphasized_decelerate" />
</set>
