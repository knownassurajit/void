<?xml version="1.0" encoding="utf-8"?>
<!-- Home leaves to the left when the app comes in from the right (LaunchAnimation.FromRight): 30% of the width, dimmed to 68%. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:fromXDelta="0"
        android:toXDelta="-30%p"
        android:duration="300"
        android:interpolator="@interpolator/emphasized_decelerate" />
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.68"
        android:duration="300"
        android:interpolator="@interpolator/emphasized_decelerate" />
</set>
