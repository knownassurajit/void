<?xml version="1.0" encoding="utf-8"?>
<!-- Home leaves upward when the app comes in from the bottom (LaunchAnimation.FromBottom): 20% of the height, dimmed to 68%. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:fromYDelta="0"
        android:toYDelta="-20%p"
        android:duration="300"
        android:interpolator="@interpolator/emphasized_decelerate" />
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.68"
        android:duration="300"
        android:interpolator="@interpolator/emphasized_decelerate" />
</set>
