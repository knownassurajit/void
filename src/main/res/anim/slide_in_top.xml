<?xml version="1.0" encoding="utf-8"?>
<!-- Comes in from the top edge over its whole height (LaunchAnimation.FromTop); Home leaves downward (slide_out_bottom). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:fromYDelta="-100%p"
        android:toYDelta="0"
        android:duration="300"
        android:interpolator="@interpolator/emphasized_decelerate" />
</set>
