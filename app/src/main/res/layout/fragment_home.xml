<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    tools:context=".ui.HomeFragment">

    <!-- Lock screen placeholder -->
    <FrameLayout
        android:id="@+id/lock"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@string/lock_layout_description" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.30">

            <!-- Clock + Date — within top section -->
            <LinearLayout
                android:id="@+id/dateTimeLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:visibility="gone"
                tools:visibility="visible">

        <!-- Time — thin display, very large, always 24h HH:MM -->
        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_regular"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:textColor="?attr/primaryColor"
            android:textSize="88sp"
            tools:text="09:41" />

        <!-- Date — Roboto regular, uppercase, well spaced -->
        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/google_sans_regular"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textColor="?attr/primaryColorTrans80"
            android:textSize="13sp"
            tools:text="WED, 25 FEB" />

        <!-- Screen time + Unlocks -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvScreenTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/google_sans_regular"
            android:letterSpacing="0.03"
            android:textColor="?attr/primaryColorTrans80"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="2h 11m • 15 unlocks"
            tools:visibility="visible" />

            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.70">

            <!-- Home apps — bottom aligned inside a single filled card -->
            <LinearLayout
                android:id="@+id/homeAppsLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="80dp">

        <TextView
            android:id="@+id/homeApp1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/google_sans_medium"
            android:hint="@string/app"
            android:includeFontPadding="false"
            android:letterSpacing="0.005"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:tag="@string/tag_1"
            android:textColor="#EEEEEE"
            android:textColorHint="#B3EEEEEE"
            android:textSize="18sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/homeApp2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/google_sans_medium"
            android:hint="@string/app"
            android:includeFontPadding="false"
            android:letterSpacing="0.005"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:tag="@string/tag_2"
            android:textColor="#EEEEEE"
            android:textColorHint="#B3EEEEEE"
            android:textSize="18sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/homeApp3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/google_sans_medium"
            android:hint="@string/app"
            android:includeFontPadding="false"
            android:letterSpacing="0.005"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:tag="@string/tag_3"
            android:textColor="#EEEEEE"
            android:textColorHint="#B3EEEEEE"
            android:textSize="18sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/homeApp4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/google_sans_medium"
            android:hint="@string/app"
            android:includeFontPadding="false"
            android:letterSpacing="0.005"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:tag="@string/tag_4"
            android:textColor="#EEEEEE"
            android:textColorHint="#B3EEEEEE"
            android:textSize="18sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/homeApp5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/google_sans_medium"
            android:hint="@string/app"
            android:includeFontPadding="false"
            android:letterSpacing="0.005"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:tag="@string/tag_5"
            android:textColor="#EEEEEE"
            android:textColorHint="#B3EEEEEE"
            android:textSize="18sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/homeApp6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/google_sans_medium"
            android:hint="@string/app"
            android:includeFontPadding="false"
            android:letterSpacing="0.005"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:tag="@string/tag_6"
            android:textColor="#EEEEEE"
            android:textColorHint="#B3EEEEEE"
            android:textSize="18sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/homeApp7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/google_sans_medium"
            android:hint="@string/app"
            android:includeFontPadding="false"
            android:letterSpacing="0.005"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:tag="@string/tag_7"
            android:textColor="#EEEEEE"
            android:textColorHint="#B3EEEEEE"
            android:textSize="18sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/homeApp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/google_sans_medium"
            android:hint="@string/app"
            android:includeFontPadding="false"
            android:letterSpacing="0.005"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:tag="@string/tag_8"
            android:textColor="#EEEEEE"
            android:textColorHint="#B3EEEEEE"
            android:textSize="18sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/homeApp9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/google_sans_medium"
            android:hint="@string/app"
            android:includeFontPadding="false"
            android:letterSpacing="0.005"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:tag="@string/tag_9"
            android:textColor="#EEEEEE"
            android:textColorHint="#B3EEEEEE"
            android:textSize="18sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/homeApp10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/google_sans_medium"
            android:hint="@string/app"
            android:includeFontPadding="false"
            android:letterSpacing="0.005"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:tag="@string/tag_10"
            android:textColor="#EEEEEE"
            android:textColorHint="#B3EEEEEE"
            android:textSize="18sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/addAppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/google_sans_medium"
            android:text="+"
            android:hint="+"
            android:includeFontPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textColor="#EEEEEE"
            android:textSize="24sp"
            android:visibility="gone" />

            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    
    <!-- Battery percentage — bottom centered -->
    <TextView
        android:id="@+id/tvBattery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/google_sans_regular"
        android:letterSpacing="0.05"
        android:textColor="?attr/primaryColorTrans80"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="77%"
        tools:visibility="visible" />

    <!-- First-run tip — centered bottom -->
    <TextView
        android:id="@+id/firstRunTips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="80dp"
        android:fontFamily="@font/google_sans_regular"
        android:letterSpacing="0.02"
        android:text="@string/swipe_up_for_apps"
        android:textColor="?attr/primaryColorTrans80"
        android:textSize="13sp"
        android:visibility="gone"
        tools:visibility="visible" />

</FrameLayout>